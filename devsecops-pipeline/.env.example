# PLI DevSecOps Pipeline — Environment Configuration
# Copy to .env and fill in before running docker compose up.

# Host IP (used in callback URLs; set to your server's IP or hostname)
HOST_IP=localhost

# ---------------------------------------------------------------------------
# Gitea → Woodpecker OAuth (create an OAuth app in Gitea after first boot)
# ---------------------------------------------------------------------------
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=

# Woodpecker
WOODPECKER_ADMIN=admin1
WOODPECKER_AGENT_SECRET=change-this-to-a-random-string

# ---------------------------------------------------------------------------
# Database passwords
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres
SONAR_DB_PASSWORD=sonarqube
DOJO_DB_PASSWORD=defectdojo

# ---------------------------------------------------------------------------
# DefectDojo
# ---------------------------------------------------------------------------
DOJO_SECRET_KEY=change-me-to-a-real-secret-key
DOJO_AES_KEY=0123456789abcdef0123456789abcdef
DOJO_API_TOKEN=

# ---------------------------------------------------------------------------
# OWASP ZAP
# ---------------------------------------------------------------------------
ZAP_API_KEY=zap-api-key-change-me

# ---------------------------------------------------------------------------
# RiskDesk integration (API token from RiskDesk Settings → API tokens)
# ---------------------------------------------------------------------------
RISKDESK_PIPELINE_TOKEN=

# ---------------------------------------------------------------------------
# Agent intervals (seconds)
# ---------------------------------------------------------------------------
TRIVY_SCAN_INTERVAL=3600
OPENSCAP_SCAN_INTERVAL=86400
