# ---------------------------------------------------------------------------
# RiskDesk configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Wiz -------------------------------------------------------------------
# Service account with read access to vulnerability and configuration findings.
# api_url is region specific -- copy it from Settings > Service Accounts in Wiz.
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_URL=https://api.us17.app.wiz.io/graphql
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZ_AUDIENCE=wiz-api
WIZ_PAGE_SIZE=500

# --- CrowdStrike Falcon ----------------------------------------------------
# API client needs the "Spotlight vulnerabilities: READ" scope.
# Match the base URL to your cloud:
#   us-1 https://api.crowdstrike.com
#   us-2 https://api.us-2.crowdstrike.com
#   eu-1 https://api.eu-1.crowdstrike.com
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
FALCON_BASE_URL=https://api.crowdstrike.com
FALCON_MEMBER_CID=
FALCON_PAGE_SIZE=400
FALCON_FILTER_FQL=status:!'closed'

# --- GitHub Advanced Security ---------------------------------------------
# Fine-grained PAT or GitHub App token with read on Dependabot alerts,
# code scanning alerts and secret scanning alerts, across the org.
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_API_URL=https://api.github.com
GITHUB_PAGE_SIZE=100
GITHUB_DEPENDABOT=1
GITHUB_CODE_SCANNING=1
GITHUB_SECRET_SCANNING=1

# --- Jira (ticket export) --------------------------------------------------
# Jira Cloud or Server for creating tickets from findings.
# These can also be set from the Sources UI (API configuration).
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=VULN
JIRA_ISSUE_TYPE=Bug

# --- People ----------------------------------------------------------------
RISKDESK_ORG_NAME=PLI
RISKDESK_USERS=admin1,admin2,security1,team1,team2,executive1,executive2
RISKDESK_APPROVERS=executive1,executive2,admin1,admin2
RISKDESK_DEFAULT_USER=admin1
RISKDESK_REQUIRE_SEPARATE_APPROVER=1

# Findings a source stops reporting are marked stale after this many days.
RISKDESK_STALE_DAYS=14

# --- Authentication -------------------------------------------------------
# "none"   no auth, everyone acts as RISKDESK_DEFAULT_USER (localhost only)
# "local"  username/password stored in the database
# "proxy"  trust headers from a reverse proxy (Azure AD, Okta, etc.)
RISKDESK_AUTH_MODE=none

# Session lifetime for local auth
RISKDESK_SESSION_HOURS=12

# Proxy-mode SSO headers (must match your IdP/reverse proxy config)
# RISKDESK_PROXY_USER_HEADER=X-Forwarded-User
# RISKDESK_PROXY_EMAIL_HEADER=X-Forwarded-Email
# RISKDESK_PROXY_NAME_HEADER=X-Forwarded-Name
# RISKDESK_PROXY_GROUPS_HEADER=X-Forwarded-Groups

# Set to 0 to disable the background scheduler (use external cron instead)
# RISKDESK_SCHEDULER_ENABLED=1
