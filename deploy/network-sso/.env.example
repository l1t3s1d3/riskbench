# --- SSO / OAuth2 Proxy ---
OAUTH_PROVIDER=oidc
OAUTH_CLIENT_ID=riskdesk
OAUTH_CLIENT_SECRET=changeme
OAUTH_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OAUTH_COOKIE_SECRET=       # generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_COOKIE_SECURE=true
OAUTH_SKIP_PROVIDER_BUTTON=false
OAUTH_SCOPES=openid email profile

# --- TLS ---
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# --- Ports ---
RISKDESK_HTTPS_PORT=443
RISKDESK_HTTP_PORT=80

# --- RiskDesk (passed through to the container) ---
RISKDESK_AUTH=proxy
RISKDESK_ORG=PLI

# --- Connector credentials (optional, can be set from the UI) ---
# WIZ_CLIENT_ID=
# WIZ_CLIENT_SECRET=
# WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
# WIZ_API_URL=https://api.us17.app.wiz.io/graphql
# FALCON_CLIENT_ID=
# FALCON_CLIENT_SECRET=
# FALCON_BASE_URL=https://api.crowdstrike.com
# GITHUB_TOKEN=
# GITHUB_ORGS=your-org
