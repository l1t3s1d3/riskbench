# RiskDesk environment file. Lives at /etc/riskdesk/env (chmod 0640 root:riskdesk).
# Only fill in what you have; connectors with missing creds just skip.

# --- Authentication ----------------------------------------------------------
# One of: none | local | proxy. Flip to 'local' for a real deployment.
RISKDESK_AUTH_MODE=local
RISKDESK_ORG_NAME=YourOrg
RISKDESK_DEFAULT_USER=admin1

# --- Wiz --------------------------------------------------------------------
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_URL=
# WIZ_AUDIENCE=wiz-api
# WIZ_RESOLVED_WINDOW_DAYS=180

# --- CrowdStrike Falcon ------------------------------------------------------
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
# FALCON_BASE_URL=https://api.crowdstrike.com
# FALCON_DETECTIONS=1
# FALCON_DETECTIONS_WINDOW_DAYS=90
# FALCON_RESOLVED_WINDOW_DAYS=180

# --- GitHub Advanced Security -----------------------------------------------
GITHUB_TOKEN=
GITHUB_ORG=
# GITHUB_RESOLVED_WINDOW_DAYS=180

# --- Notifications (optional) ------------------------------------------------
# RISKDESK_SLACK_WEBHOOK=
# RISKDESK_SMTP_HOST=
# RISKDESK_EMAIL_FROM=
# RISKDESK_EMAIL_TO=sec-ops@example.com,ciso@example.com

# --- Jira (optional) --------------------------------------------------------
# Set these from the admin UI instead; connector_configs stores them encrypted-at-rest.

# --- Scheduler --------------------------------------------------------------
# RISKDESK_SCHEDULER_ENABLED=1
# RISKDESK_STALE_DAYS=14
